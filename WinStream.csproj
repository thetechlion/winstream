<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinStream</AssemblyName>
    <RootNamespace>WinStream</RootNamespace>
    <!-- Velopack needs its own Main() so it can handle install/update hooks first -->
    <StartupObject>WinStream.App</StartupObject>
    <!-- Local default; the release workflow overrides this from the git tag -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="Velopack" Version="*" />
  </ItemGroup>

</Project>
